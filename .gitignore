node_modules/
lib/
dist/
*.tsbuildinfo
coverage/
.dsh-applications/
.applications/

.superpowers/
.playwright-mcp/
.serena/

# 本地 agent 状态/配置（CLAUDE.md/AGENTS.md 作为说明文件仍提交；
# .claude/、.agents/、.codex/ 是维护者本地工具与运行态，不入库）
.claude/
.agents/
.codex/

# 本机 scratch（探针/截图等生成物）
tmp/

# pnpm 的 workspace 本地 store（scripts/pnpm-store.mjs）：纯缓存，随仓删除，
# 不进版本库；删掉后 `pnpm run deps` 会重新水化。
.pnpm-store/

# typert 生成产物：tsdown 的 typert 步骤在 vendored 壳内就地写出的 .js/.d.ts（与 src/*.ts 同名会撞 TS2717 噪音）；generator 工作镜像树（packages/typert/packages/）
packages/typert/protocol/src/*.js
packages/typert/protocol/src/*.js.map
packages/typert/protocol/src/*.d.ts
packages/typert/protocol/src/*.d.ts.map
packages/typert/packages/

# 环境/机密（提交 .env.example，绝不提交真实 key）
.env
.env.*
!.env.example

# OS / editor / log 杂物
.DS_Store
*.log
.idea/
.vscode/
.gstack/
