{
  "name": "@matrix1001/dsh-application-harness-client-applications",
  "description": "The browser's application shell: the applications panel (list, switching, calls with cancellation, progress, history, grants, out-of-session confirmation) and the `applicationViews` registry a client package renders its own application page through",
  "version": "0.1.1",
  "engines": {
    "dsh": "0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "packages/client/applications"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-session-status"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-session-status": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.3-alpha.2",
    "@matrix1001/dsh-application-harness-client-chrome": "workspace:*",
    "@matrix1001/dsh-application-harness-host-bridge": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "author": "matrix1001"
}
