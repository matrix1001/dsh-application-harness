{
  "name": "@matrix1001/dsh-application-harness-client-chrome",
  "description": "Shared application world-view page chrome (Section + TabBar): a browser-static library each consuming client bundle inlines",
  "version": "0.1.0",
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "packages/client/chrome"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/cordis": "4.1.0",
    "@matrix1001/dsh-application-harness-client-applications": "workspace:*",
    "@matrix1001/dsh-application-harness-host-bridge": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "author": "matrix1001"
}
