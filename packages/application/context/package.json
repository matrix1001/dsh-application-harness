{
  "name": "@matrix1001/dsh-application-harness-context",
  "description": "Page-context resolution for the application harness: reads the `@page:` citations a browser page chip serialized into a prompt, verifies each cited record through the application's own AI-open read operation, and injects the verified references — stale ones marked stale, unopenable ones omitted — as one structured message right after the citing one",
  "version": "0.1.0",
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "packages/application/context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2"
  },
  "devDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2"
  },
  "author": "matrix1001"
}
