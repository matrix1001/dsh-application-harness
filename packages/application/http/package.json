{
  "name": "@matrix1001/dsh-application-harness-http",
  "description": "The harness network capability (ctx.applicationHttp): applications make outbound requests through it and the harness forward proxy (row config, environment fallback) applies automatically",
  "version": "0.1.0",
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "packages/application/http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-http-proxy": "0.2.2-rc.2"
  },
  "author": "matrix1001"
}
