{
  "name": "@matrix1001/dsh-application-harness-store",
  "description": "Application data store (ctx.applicationStore): per-app SQLite documents/collections with namespace isolation, migrations, export and backup",
  "version": "0.1.1",
  "engines": {
    "dsh": "0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "packages/application/store"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./atomic": {
      "types": "./lib/types/atomic.d.ts",
      "default": "./lib/atomic.js"
    },
    "./sqlite-store": {
      "types": "./lib/types/sqlite-store.d.ts",
      "default": "./lib/sqlite-store.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/atomic.js",
    "lib/sqlite-store.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1"
  },
  "author": "matrix1001"
}
