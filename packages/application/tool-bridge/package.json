{
  "name": "@matrix1001/dsh-application-harness-tool-bridge",
  "description": "Application harness AI tool face for the DeepSeek Harness — one declaration-driven `applications` tool (view/read/call), a read-only `pages` context and a shared-draft `drafts` tool, scoped to marked application/development conversations and @-referenced applications; each call runs through the application runtime's one call path",
  "version": "0.1.0",
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "packages/application/tool-bridge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2",
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2",
    "@deepseek-ai/cordis": "4.1.0"
  },
  "author": "matrix1001"
}
