{
  "name": "@matrix1001/dsh-application-harness-inbox",
  "description": "信息收件箱：GitHub 版本、RSS/Atom、网页监控与手动链接，条目转任务或存为笔记",
  "version": "0.1.0",
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "packages/examples/inbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@matrix1001/dsh-application-harness-store": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@matrix1001/dsh-application-harness-store": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0"
  },
  "dsh": {
    "appRow": {
      "id": "inbox",
      "name": "@matrix1001/dsh-application-harness-inbox"
    }
  },
  "author": "matrix1001"
}
