{
  "name": "@matrix1001/dsh-application-harness-disk-space",
  "description": "磁盘空间：扫描目录、浏览占用、查找重复文件与可恢复的回收站",
  "version": "0.1.0",
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "packages/examples/disk-space"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0"
  },
  "dsh": {
    "appRow": {
      "id": "disk-space",
      "name": "@matrix1001/dsh-application-harness-disk-space",
      "config": {
        "databasePath": "!!js dshHomePath('application-harness/disk-space/index.db')"
      }
    }
  },
  "author": "matrix1001"
}
