{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ],
    "paths": {
      "@matrix1001/dsh-application-harness-runtime": [
        "./packages/application/runtime/src/index.ts"
      ],
      "@matrix1001/dsh-application-harness-runtime/types": [
        "./packages/application/runtime/src/types.ts"
      ],
      "@matrix1001/dsh-application-harness-tool-bridge": [
        "./packages/application/tool-bridge/src/index.ts"
      ],
      "@matrix1001/dsh-application-harness-host-bridge": [
        "./packages/application/host-bridge/src/index.ts"
      ],
      "@matrix1001/dsh-application-harness-host-bridge/types": [
        "./packages/application/host-bridge/src/types.ts"
      ],
      "@matrix1001/dsh-application-harness-host-bridge/client": [
        "./packages/application/host-bridge/src/client.ts"
      ],
      // The build plane resolves the typert protocol peer to the registration
      // shell's vendored source (packages/typert/protocol/src, a committed
      // snapshot that follows the platform checkout); package builds consume
      // the shell's emitted declarations through the project reference. The
      // shell stays a registered project so the generator recognizes its
      // type-meta symbols, but its Context augmentation is removed locally so
      // discovery does not treat it as a contributor. The source plane
      // (tsconfig.test-paths.json) leaves the package to normal node_modules
      // resolution.
      "@deepseek-ai/dsh-typert-protocol": [
        "./packages/typert/protocol/src/index.ts"
      ]
    }
  }
}
