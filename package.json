  "name": "dsh-application-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "validate:app": "node scripts/validate-app.mjs",
    "start": "node scripts/start.mjs",
    "start:build": "node scripts/start.mjs --build",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:tests": "node scripts/typecheck-tests.mjs",
    "typecheck:tests:selftest": "node scripts/typecheck-tests.mjs --self-test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify-version-sync": "node scripts/verify-version-sync.mjs",
    "build": "pnpm run typecheck:release && pnpm exec tsdown && DSH_BUILD_FACE=client pnpm exec tsdown",
    "release:check": "pnpm run test:coverage && pnpm run build && pnpm run test:scripts && pnpm -r exec publint && node scripts/verify-build-role.mjs && node scripts/verify-engines.mjs && node scripts/verify-version-sync.mjs && node scripts/verify-machinery-rows.mjs && node scripts/verify-platform-package-set.mjs && node scripts/verify-deployment-descriptor.mjs && node scripts/verify-layer-deps.mjs && node scripts/verify-example-compositions.mjs && node scripts/verify-execution-line.mjs && node scripts/verify-inject-contract.mjs && node scripts/verify-client-peer-shape.mjs && node scripts/verify-client-factory.mjs && node scripts/verify-pack.mjs && node scripts/verify-runtime-deps.mjs && node scripts/verify-app-scale.mjs --strict && node scripts/verify-api-snapshot.mjs && node scripts/platform-line.mjs --check && node scripts/launch-apps.mjs --check-only && node scripts/vendor-platform-src.mjs --self-test && node scripts/vendor-platform-src.mjs --check && node scripts/verify-platform-modules.mjs && node scripts/generate-bundle-patch.mjs --check && node scripts/smoke.mjs applications && node scripts/smoke.mjs applications --tooled",
    "clean": "node scripts/clean.mjs",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "gate": "node scripts/gate.mjs",
    "launch": "node scripts/launch-apps.mjs",
    "check:launch": "node scripts/launch-apps.mjs --check-only",
    "verify-platform-src": "node scripts/vendor-platform-src.mjs --check",
    "verify-platform-modules": "node scripts/verify-platform-modules.mjs",
    "verify-engines": "node scripts/verify-engines.mjs",
    "deps": "node scripts/deps.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:plugin": "node scripts/test-plugin-local.mjs",
    "version:set": "node scripts/version.mjs",
    "dev": "node scripts/dev.mjs",
    "build:plugin-tarball": "node scripts/build-plugin-tarball.mjs",
    "typecheck:checkout": "node scripts/typecheck.mjs",
    "typecheck:release": "env -u npm_command tsc -b --force tsconfig.host.json && node scripts/generate-typert.mjs && env -u npm_command tsc -b --force tsconfig.client.json && pnpm run typecheck:tests",
    "build:dev": "node scripts/build-dev.mjs",
    "release:line": "node scripts/verify-release-line.mjs"
  },
