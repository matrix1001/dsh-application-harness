    "clean": "node scripts/clean.mjs",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "check:docs": "node --test scripts/tests/docs.test.mjs",
    "gate": "node scripts/gate.mjs",
    "launch": "node scripts/launch-apps.mjs",
    "check:launch": "node scripts/launch-apps.mjs --check-only",
    "verify-platform-modules": "node scripts/verify-platform-modules.mjs",
    "verify-engines": "node scripts/verify-engines.mjs",
    "deps": "node scripts/deps.mjs",
    "test:plugin": "node scripts/test-plugin-local.mjs",
    "version:set": "node scripts/version.mjs",
    "dev": "node scripts/dev.mjs",
    "build:plugin-tarball": "node scripts/build-plugin-tarball.mjs",
    "typecheck:release": "node scripts/typecheck.mjs",
    "build:dev": "node scripts/build-dev.mjs",
    "pretest": "node scripts/sync-platform-fixture.mjs --ensure",
    "pretest:coverage": "node scripts/sync-platform-fixture.mjs --ensure",
    "test:diff": "node scripts/check-diff-coverage.mjs",
    "coverage:uncovered": "node scripts/uncovered-locations.mjs",
    "test:browser": "node --test \"tests/browser/*.test.mjs\"",
    "verify-node-line": "node scripts/verify-node-line.mjs"
  },
