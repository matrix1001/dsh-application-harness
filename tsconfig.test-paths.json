{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@matrix1001/dsh-application-harness-runtime": [
        "./packages/application/runtime/src/index.ts"
      ],
      "@matrix1001/dsh-application-harness-runtime/types": [
        "./packages/application/runtime/src/types.ts"
      ],
      "@matrix1001/dsh-application-harness-tool-bridge": [
        "./packages/application/tool-bridge/src/index.ts"
      ],
      "@matrix1001/dsh-application-harness-context": [
        "./packages/application/context/src/index.ts"
      ],
      "@matrix1001/dsh-application-harness-store": [
        "./packages/application/store/src/index.ts"
      ],
      "@matrix1001/dsh-application-harness-store/atomic": [
        "./packages/application/store/src/atomic.ts"
      ],
      "@matrix1001/dsh-application-harness-store/sqlite-store": [
        "./packages/application/store/src/sqlite-store.ts"
      ],
      "@matrix1001/dsh-application-harness-host-bridge": [
        "./packages/application/host-bridge/src/index.ts"
      ],
      // The wire vocabulary the *view* packages' shape-comparison suites assert
      // against: the op-result type modules of the applications whose world
      // views render them. Type-only imports — the client sources themselves
      // never name these packages (the layer gate stays unchanged); only the
      // test plane reads them, and it must read the SOURCE (a built
      // `lib/types/*.d.ts` would be the very drift these suites exist to catch).
      "@matrix1001/dsh-application-harness-http": [
        "./packages/application/http/src/index.ts"
      ],
      "@deepseek-ai/dsh-api-gateway/client": [
        "./.platform-src/dsh-api-gateway/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-api-session-controller/client": [
        "./.platform-src/dsh-api-session-controller/src/client/index.ts"
      ],
      // The vendored trees import each other in the platform's own source style
      // (`.../src/client/scope.ts`), which no published `exports` map answers —
      // the wildcard keeps such a cross-tree import inside the vendored plane
      // instead of escaping to node_modules (0.1.6-alpha.2's test-runtime gained
      // exactly one of these; same shape as the ui-renderer entry below).
      "@deepseek-ai/dsh-api-session-controller/src/*": [
        "./.platform-src/dsh-api-session-controller/src/*"
      ],
      "@deepseek-ai/dsh-client-connection/client": [
        "./.platform-src/dsh-client-connection/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        "./.platform-src/dsh-client-locale/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-store": [
        "./.platform-src/dsh-client-store/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-test-runtime": [
        "./.platform-src/dsh-client-test-runtime/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-chat/client": [
        "./.platform-src/dsh-client-ui-chat/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-context-menu/client": [
        "./.platform-src/dsh-client-ui-context-menu/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-context-menu/src/*": [
        "./.platform-src/dsh-client-ui-context-menu/src/*"
      ],
      "@deepseek-ai/dsh-client-ui-conversation/client": [
        "./.platform-src/dsh-client-ui-conversation/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-token-meter/client": [
        "./.platform-src/dsh-token-meter/src/client.ts"
      ],
      "@deepseek-ai/dsh-client-ui-session/client": [
        "./.platform-src/dsh-client-ui-session/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-renderer/src/*": [
        "./.platform-src/dsh-client-ui-renderer/src/*"
      ],
      "@deepseek-ai/dsh-client-ui-renderer/client": [
        "./.platform-src/dsh-client-ui-renderer/src/client/index.ts"
      ],
      "@matrix1001/dsh-application-harness-host-bridge/types": [
        "./packages/application/host-bridge/src/types.ts"
      ],
      "@matrix1001/dsh-application-harness-host-bridge/client": [
        "./packages/application/host-bridge/src/client.ts"
      ],
      "@matrix1001/dsh-application-harness-client-chrome": [
        "./packages/client/chrome/src"
      ],
      "@matrix1001/dsh-application-harness-client-object-reference": [
        "./packages/client/object-reference/src/index.tsx"
      ],
      "@matrix1001/dsh-application-harness-client-applications": [
        "./packages/client/applications/src"
      ],
      "@matrix1001/dsh-application-harness-client-applications/client": [
        "./packages/client/applications/src/client"
      ],
    }
  }
}
