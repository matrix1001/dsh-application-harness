{
  "name": "@matrix1001/dsh-application-harness-inbox-view",
  "version": "0.1.1",
  "description": "The inbox application page for the applications shell",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "0.2.3-alpha.2"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "appRow": {
      "id": "client-ui-inbox",
      "name": "@matrix1001/dsh-application-harness-inbox-view",
      "appId": "inbox"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1"
  },
  "devDependencies": {
    "@matrix1001/dsh-application-harness-client-applications": "workspace:*",
    "@matrix1001/dsh-application-harness-client-chrome": "workspace:*",
    "@matrix1001/dsh-application-harness-client-object-reference": "workspace:*",
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "apps/inbox/view"
  },
  "author": "matrix1001",
  "publishConfig": {
    "access": "public"
  }
}
