{
  "name": "@matrix1001/dsh-application-harness-git-browser",
  "version": "0.1.1",
  "description": "Git 浏览：只读地读取本地仓库状态、文件级 diff、提交历史与提交详情",
  "engines": {
    "dsh": "0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix1001/dsh-application-harness.git",
    "directory": "apps/git-browser/host"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.20.0-alpha.1"
  },
  "peerDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.2.3-alpha.2"
  },
  "devDependencies": {
    "@matrix1001/dsh-application-harness-runtime": "workspace:*",
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.2.3-alpha.2"
  },
  "dsh": {
    "appRow": {
      "id": "git-browser",
      "name": "@matrix1001/dsh-application-harness-git-browser",
      "config": {
        "timeoutMs": 10000
      }
    }
  },
  "author": "matrix1001"
}
